{
  "name": "padtars-server",
  "version": "0.1.0",
  "private": true,
  "description": "Hosted, read-only KRÉTA MCP server: OAuth 2.1 AS whose /authorize is the KRÉTA login, with sealed, storage-free tokens.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "keygen": "tsx scripts/keygen.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^4.21.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
