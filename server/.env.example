# Required. 32 random bytes, base64. The ONLY key protecting every issued
# token — rotating it invalidates every connection, and every parent has to
# reconnect. Generate with: npm run keygen
TOKEN_SEALING_KEY=""

# Public origin of this deployment, used as the OAuth issuer. Leave empty to
# derive it from the incoming request (fine behind a single proxy, explicit
# is better).
OAUTH_ISSUER="https://uzenofuzet.hu"

# Comma-separated exact redirect URIs a registered MCP client may use.
# Defaults to Claude's two connector callbacks; set it to add a local client.
# OAUTH_ALLOWED_REDIRECT_URIS="https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback"

# Optional TTLs.
# OAUTH_CODE_TTL_SECONDS="120"
# OAUTH_ACCESS_TOKEN_TTL_SECONDS="2592000"

# Per-child Google Classroom OAuth. Create a Google Cloud "Web application"
# OAuth client and register this exact callback on the deployed public origin:
# https://uzenofuzet.hu/api/classroom/callback
# Keep the secret in Secret Manager; it must never enter the Astro frontend.
GOOGLE_CLASSROOM_CLIENT_ID=""
GOOGLE_CLASSROOM_CLIENT_SECRET=""

# Encrypted Classroom refresh grants require re-authorization after one year.
# GOOGLE_CLASSROOM_CREDENTIAL_TTL_SECONDS="31622400"

# Cloud Scheduler OIDC protection for POST /internal/refresh-connections.
# The audience is the direct run.app origin, not the Firebase custom domain.
# REFRESH_JOB_AUDIENCE="https://uzenofuzet-xxxxxxxxxx-ew.a.run.app"
# REFRESH_JOB_SERVICE_ACCOUNT="uzenofuzet-refresher@uzenofuzet.iam.gserviceaccount.com"
