---
/** A Claude-csatlakozó címe: a gyereklista alatt, de az első képernyőn. */
---

<section class="connector" aria-labelledby="connector-title">
  <header>
    <h2 id="connector-title">Claude-csatlakozó</h2>
    <span>Beállítás</span>
  </header>
  <p>Másold ezt a címet egyéni csatlakozóként Claude-ba.</p>
  <div class="url-row">
    <code id="connector-url">https://uzenofuzet.hu/mcp</code>
    <button id="copy-url" type="button">Másolás</button>
  </div>
  <p id="copy-status" role="status" aria-live="polite"></p>
  <p class="connector-path">Claude → Beállítások → Csatlakozók → Egyéni csatlakozó hozzáadása</p>
</section>

<script>
  import { startConnector } from "../../scripts/dashboard/connector";
  startConnector();
</script>

<style>
  .connector { padding: 0 clamp(1.25rem, 3vw, 2.25rem) 1.25rem; border-top: 2px solid var(--blue); background: #eef2f8; }

  .connector header {
    display: flex;
    min-height: 3.25rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--blue-soft);
  }

  h2 { margin: 0; font-size: .95rem; letter-spacing: -.02em; }

  .connector header span {
    color: var(--ink-muted);
    font-family: "IBM Plex Mono", monospace;
    font-size: .6rem;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .connector > p:first-of-type { margin: .85rem 0 .6rem; color: var(--ink-muted); font-size: .78rem; line-height: 1.5; }

  .url-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    border: 1px solid var(--blue-soft);
    background: var(--paper-bright);
  }

  .url-row { background: var(--paper-bright); }

  .url-row code {
    min-width: 0;
    overflow-x: auto;
    padding: .8rem 1rem;
    color: var(--blue);
    font-family: "IBM Plex Mono", monospace;
    font-size: .75rem;
    line-height: 1.5;
  }

  .url-row button {
    min-width: 6rem;
    border: 0;
    border-left: 1px solid var(--blue-soft);
    color: var(--blue);
    background: #eef2f8;
    font-size: .75rem;
    font-weight: 800;
    cursor: pointer;
  }

  .url-row button:hover { color: white; background: var(--blue); }
  #copy-status { min-height: 1.1rem; margin: .5rem 0 0; color: var(--green); font-size: .72rem; }
  .connector-path { margin: .15rem 0 0; color: var(--ink-muted); font-size: .72rem; line-height: 1.5; }

  @media (max-width: 560px) {
    .url-row { grid-template-columns: 1fr; }
    .url-row button { min-height: 3rem; border-top: 1px solid var(--blue-soft); border-left: 0; }
  }
</style>
