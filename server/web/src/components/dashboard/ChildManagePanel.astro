---
/** Egy gyerek kezelése: ritkán kellő adatok, kapcsolatok és a külön veszélyzóna. */
---

<dialog class="manage-panel" id="manage-panel" aria-labelledby="manage-title">
  <header>
    <div>
      <h2 id="manage-title" tabindex="-1">Gyerek</h2>
      <p>Azonosítók, kapcsolatok és a veszélyes műveletek egy helyen.</p>
    </div>
    <button id="manage-close" type="button">Bezárás</button>
  </header>

  <div class="manage-body">
    <dl class="facts">
      <div><dt>KRÉTA-felhasználónév</dt><dd id="manage-username"></dd></div>
      <div><dt>Intézmény</dt><dd id="manage-institute"></dd></div>
    </dl>

    <section class="source" aria-labelledby="manage-kreta-title">
      <h3 id="manage-kreta-title">KRÉTA-kapcsolat</h3>
      <p class="state" id="manage-kreta-state"></p>
      <p class="detail" id="manage-kreta-detail"></p>
      <button class="source-action" id="manage-kreta-connect" type="button">Online kapcsolás</button>
    </section>

    <section class="source" aria-labelledby="manage-classroom-title">
      <h3 id="manage-classroom-title">Google Classroom</h3>
      <p class="state" id="manage-classroom-state"></p>
      <p class="detail" id="manage-classroom-detail"></p>
      <button class="source-action" id="manage-classroom-connect" type="button">Classroom összekapcsolása</button>
    </section>

    <button class="edit-profile" id="manage-edit" type="button">Profil szerkesztése</button>

    <section class="danger" aria-labelledby="manage-danger-title">
      <h3 id="manage-danger-title">Veszélyzóna</h3>

      <div class="danger-item" id="danger-kreta">
        <div class="danger-head">
          <div>
            <strong>KRÉTA-kapcsolat leállítása</strong>
            <span>A gyerekprofil megmarad, de a KRÉTA-adatok nem lesznek elérhetők Claude-nak.</span>
          </div>
          <button type="button" data-danger-open>Leállítás</button>
        </div>
        <div class="danger-confirm" data-danger-confirm-box hidden>
          <p>Biztosan leállítod <span data-child-name></span> KRÉTA-kapcsolatát?</p>
          <div>
            <button type="button" data-danger-confirm>Igen, leállítom</button>
            <button type="button" data-danger-cancel>Mégse</button>
          </div>
        </div>
      </div>

      <div class="danger-item" id="danger-classroom">
        <div class="danger-head">
          <div>
            <strong>Classroom-fiók leválasztása</strong>
            <span>A gyerekprofil megmarad, de a Classroom-adatok nem lesznek elérhetők Claude-nak.</span>
          </div>
          <button type="button" data-danger-open>Leválasztás</button>
        </div>
        <div class="danger-confirm" data-danger-confirm-box hidden>
          <p>Biztosan leválasztod <span data-child-name></span> Classroom-fiókját?</p>
          <div>
            <button type="button" data-danger-confirm>Igen, leválasztom</button>
            <button type="button" data-danger-cancel>Mégse</button>
          </div>
        </div>
      </div>

      <div class="danger-item" id="danger-delete">
        <div class="danger-head">
          <div>
            <strong>Gyerekprofil törlése</strong>
            <span>A profillal együtt a KRÉTA- és a Classroom-kapcsolat is törlődik. Ez nem vonható vissza.</span>
          </div>
          <button type="button" data-danger-open>Törlés</button>
        </div>
        <div class="danger-confirm" data-danger-confirm-box hidden>
          <p>
            Törlöd <span data-child-name></span> gyerekprofilját? A KRÉTA- és a Classroom-kapcsolata is megszűnik.
          </p>
          <div>
            <button type="button" data-danger-confirm>Igen, törlöm</button>
            <button type="button" data-danger-cancel>Mégse</button>
          </div>
        </div>
      </div>
    </section>

    <p class="manage-status" id="manage-status" role="status"></p>
  </div>
</dialog>

<style>
  .manage-panel {
    width: min(100%, 34rem);
    max-width: 100%;
    max-height: min(88vh, 46rem);
    padding: 0;
    border: 2px solid var(--blue);
    border-radius: 0;
    color: var(--ink);
    background: var(--paper-bright);
  }

  .manage-panel::backdrop { background: rgb(11 18 28 / 55%); }

  .manage-panel header {
    position: sticky;
    top: 0;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 1.35rem;
    border-bottom: 2px solid var(--blue);
    background: var(--paper-bright);
  }

  h2 { margin: 0; font-size: 1.25rem; letter-spacing: -.03em; }
  h2:focus-visible { outline: 3px solid var(--red); outline-offset: .35rem; }
  .manage-panel header p { margin: .25rem 0 0; color: var(--ink-muted); font-size: .75rem; line-height: 1.45; }

  #manage-close {
    min-height: 2.5rem;
    flex: 0 0 auto;
    padding: .35rem .8rem;
    border: 1px solid var(--blue-soft);
    border-radius: 0;
    color: var(--blue);
    background: transparent;
    font-size: .75rem;
    font-weight: 800;
    cursor: pointer;
  }

  .manage-body { padding: 0 1.35rem 1.35rem; }

  .facts { margin: 0; padding: .35rem 0 0; }
  .facts > div { display: grid; grid-template-columns: minmax(9rem, .8fr) minmax(0, 1.2fr); gap: .5rem 1rem; padding: .7rem 0; border-bottom: 1px solid var(--blue-soft); }
  dt { color: var(--ink-muted); font-family: "IBM Plex Mono", monospace; font-size: .68rem; }
  dd { margin: 0; overflow-wrap: anywhere; color: var(--blue); font-family: "IBM Plex Mono", monospace; font-size: .78rem; }

  .source { padding: 1rem 0; border-bottom: 1px solid var(--blue-soft); }
  h3 { margin: 0; font-size: .85rem; letter-spacing: -.02em; }
  .state { margin: .45rem 0 0; color: var(--ink-muted); font-size: .82rem; font-weight: 800; }
  .state.online { color: var(--green); }
  .detail { margin: .3rem 0 0; color: var(--ink-muted); font-size: .78rem; line-height: 1.5; }

  .source-action {
    min-height: 2.75rem;
    margin-top: .8rem;
    padding: .5rem 1rem;
    border: 2px solid var(--blue-strong);
    border-radius: 0;
    color: white;
    background: var(--blue-strong);
    font-size: .78rem;
    font-weight: 800;
    cursor: pointer;
  }

  .source-action:hover { background: var(--blue); }
  .source-action:disabled { cursor: wait; opacity: .65; }

  .edit-profile {
    width: 100%;
    min-height: 2.9rem;
    margin: 1rem 0 0;
    border: 1px solid var(--blue);
    border-radius: 0;
    color: var(--blue);
    background: transparent;
    font-size: .8rem;
    font-weight: 800;
    cursor: pointer;
  }

  .edit-profile:hover { color: white; background: var(--blue); }

  .danger { margin-top: 1.4rem; padding: 0 1rem 1rem; border: 1px solid #d7a49a; background: #fff6f4; }
  .danger h3 { padding: .85rem 0 .6rem; color: #a62f22; }
  .danger-item + .danger-item { border-top: 1px solid #e8cdc7; }
  .danger-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .75rem 0; }
  .danger-head strong { display: block; font-size: .8rem; }
  .danger-head span { display: block; margin-top: .2rem; color: var(--ink-muted); font-size: .75rem; line-height: 1.45; }

  .danger-head button {
    min-height: 2.5rem;
    flex: 0 0 auto;
    padding: .4rem .9rem;
    border: 1px solid #a62f22;
    border-radius: 0;
    color: #a62f22;
    background: transparent;
    font-size: .75rem;
    font-weight: 800;
    cursor: pointer;
  }

  .danger-head button:hover { color: white; background: #a62f22; }
  .danger-confirm { padding: .3rem 0 .9rem; }
  .danger-confirm p { margin: 0 0 .6rem; color: #6e2018; font-size: .78rem; font-weight: 700; line-height: 1.5; }
  .danger-confirm > div { display: flex; flex-wrap: wrap; gap: .6rem; }

  .danger-confirm button {
    min-height: 2.6rem;
    padding: .45rem 1rem;
    border: 2px solid #a62f22;
    border-radius: 0;
    font-size: .75rem;
    font-weight: 800;
    cursor: pointer;
  }

  [data-danger-confirm] { color: white; background: #a62f22; }
  [data-danger-cancel] { border-color: var(--blue-soft); color: var(--blue); background: transparent; }
  [data-danger-confirm]:disabled { cursor: wait; opacity: .65; }

  .manage-status { min-height: 1.2rem; margin: .9rem 0 0; color: var(--ink-muted); font-size: .78rem; line-height: 1.45; }
  .manage-status[data-kind="error"] { color: #a62f22; }

  @media (max-width: 560px) {
    .manage-panel { width: 100%; max-height: 92vh; margin: auto 0 0; }
    .facts > div { grid-template-columns: 1fr; gap: .2rem; }
    .danger-head { align-items: stretch; flex-direction: column; gap: .6rem; }
    .danger-head button, .danger-confirm button { width: 100%; }
  }
</style>
