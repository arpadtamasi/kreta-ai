---
import BrandMark from "./BrandMark.astro";
---

<footer>
  <BrandMark />
  <p>Független, nyílt forrású kezdeményezés. Nem az eKRÉTA Zrt. hivatalos szolgáltatása.</p>
  <nav aria-label="Lábléc navigáció">
    <a href="/hogy-mukodik">Hogy működik?</a>
    <a href="/iskolai-admin">Iskolai admin</a>
    <a href="/adatkezeles">Adatkezelés</a>
    <a href="/felhasznalasi-feltetelek">Feltételek</a>
  </nav>
</footer>

<style>
  footer {
    display: grid;
    grid-template-columns: auto minmax(15rem, 1fr) auto;
    gap: 2rem;
    align-items: center;
    padding: 2.2rem var(--page-pad);
    border-top: 1px solid var(--blue-soft);
  }
  /* 42rem 11.5px-es szövegnél 125 karakteres sor volt; 23rem ~70. */
  p { max-width: 23rem; margin: 0; color: var(--ink-muted); font-size: .78rem; line-height: 1.6; }
  nav { display: flex; flex-wrap: wrap; gap: 0 1.4rem; }
  /* Önálló navigációs cél: 44px magas találati terület kell hozzá. */
  nav a { display: inline-flex; min-height: 44px; align-items: center; color: var(--blue); font-size: .8rem; font-weight: 700; text-underline-offset: .25rem; }
  @media (max-width: 760px) {
    footer { grid-template-columns: 1fr; gap: 1.25rem; }
    nav { flex-wrap: wrap; }
  }
</style>
