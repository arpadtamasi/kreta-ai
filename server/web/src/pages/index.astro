---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArrowMark from "../components/ArrowMark.astro";
import SparkMark from "../components/SparkMark.astro";
import PledgeWall from "../components/PledgeWall.astro";

const lessons = [
  ["1.", "8:00", "történelem", "a reformkor fő kérdései"],
  ["2.", "8:55", "matematika", "másodfokú egyenletek"],
  ["4.", "10:50", "biológia", "a sejtek anyagcseréje"],
  ["5.", "11:45", "angol", "travel and directions"],
  ["6.", "12:40", "testnevelés", "kosárlabda"],
];
---

<BaseLayout>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <h1 id="hero-title"><span>Mi volt ma</span><span>az iskolában?</span></h1>
      <p class="tool-label">KRÉTA napló használata</p>
      <p class="hero-lede">Ne csak az órarendet lásd. Kérdezz rá arra, ami tényleg figyelmet érdemel.</p>
      <div class="hero-actions">
        <a class="button" href="/dashboard">Kapcsold össze Claude-dal <ArrowMark /></a>
        <a class="text-link" href="#uzenetfal">Mondd el, miért kell <ArrowMark direction="down" /></a>
      </div>
      <p class="hero-meta">Üzenőfüzet · KRÉTA–Claude összekapcsoló · olvasási hozzáférés</p>
    </div>

    <div class="transcript" aria-label="Szintetikus példabeszélgetés">
      <div class="ruler" aria-hidden="true">
        <span>0</span><i></i><i></i><i></i><span>10</span><i></i><i></i><i></i><span>20</span>
      </div>
      <p class="demo-tag">Bemutató · nem valós tanulói adatok</p>

      <article class="message question">
        <div class="avatar" aria-hidden="true">ÉN</div>
        <div>
          <div class="speaker-line"><strong>Mi volt ma az iskolában?</strong><time>08:03</time></div>
          <p class="tool-line">KRÉTA napló használata</p>
        </div>
      </article>

      <article class="message answer">
        <div class="claude-mark"><SparkMark /></div>
        <div class="answer-body">
          <div class="speaker-line claude-label"><strong>Claude</strong><time>08:03</time></div>
          <p><strong>Lillánál</strong> ma ez van naplózva — Áron adatait most nem érem el:</p>
          <ol class="lesson-list">
            {lessons.map(([number, time, subject, topic]) => (
              <li>
                <span class="lesson-number">{number}</span>
                <time>{time}</time>
                <strong>{subject}</strong>
                <span>{topic}</span>
              </li>
            ))}
          </ol>
          <p class="presence">A naplózott órákon jelenlét, házi feladat nincs csatolva.</p>
        </div>
      </article>

      <article class="message follow-up">
        <div class="avatar" aria-hidden="true">ÉN</div>
        <div class="speaker-line"><strong>Áront is eléred? Tegnap ment.</strong><time>08:05</time></div>
      </article>

      <article class="message status-message">
        <div class="claude-mark"><SparkMark /></div>
        <div class="answer-body">
          <div class="speaker-line claude-label"><strong>Állapot</strong><time>08:05</time></div>
          <p>Egy bejelentkezési probléma megoldásán dolgozva.<span class="working-dots" aria-label="folyamatban">•••</span></p>
        </div>
      </article>

      <article class="message answer second-answer">
        <div class="claude-mark"><SparkMark /></div>
        <div class="answer-body">
          <div class="speaker-line claude-label"><strong>Claude</strong><time>08:06</time></div>
          <p><strong>Áron mai napja:</strong></p>

          <aside class="insight">
            <div class="bracket" aria-hidden="true"></div>
            <p class="insight-title">Amit érdemes megnézned:</p>
            <p>Szerdán a 3. órai kémiáról hiányzás van rögzítve, <span class="circled">„igazolandó”</span> állapotban. Ez az egyetlen hiányzása ezen a héten, és az óra témája a pénteki dolgozat előkészítése volt.</p>
            <p class="all-good">A többi tárgyban rendben van: hétfőn és csütörtökön mindenhol jelenlét.</p>
          </aside>
        </div>
      </article>
      <p class="margin-note">Ez már nem naplóbejegyzés.<br />Ez összefüggés.</p>
    </div>
  </section>

  <section class="value" aria-labelledby="value-title">
    <div class="value-heading">
      <h2 id="value-title">Nem újabb napló.<br />A fontos rész<br />nem a lista.</h2>
    </div>
    <div class="value-copy">
      <p class="big-copy">Az Üzenőfüzet összeköti a hiányzást az óra témájával, a dolgozatot az előző hetek anyagával, a mai napot azzal, ami eltér a megszokottól.</p>
      <div class="value-grid">
        <article><span>01</span><h3>Kérdezz természetesen</h3><p>„Mire készüljünk holnap?” vagy „Volt valami szokatlan ezen a héten?”</p></article>
        <article><span>02</span><h3>Kapj összefüggést</h3><p>Claude nemcsak visszaolvassa a KRÉTA-t, hanem kiemeli, mire érdemes ránézni.</p></article>
        <article><span>03</span><h3>Maradj döntési helyzetben</h3><p>Az eszközök csak olvasnak. Sem jegyet, sem igazolást, sem üzenetet nem módosítanak.</p></article>
      </div>
      <a class="line-link" href="/hogyan-mukodik">A működés és a bizalmi határ részletesen <ArrowMark /></a>
    </div>
  </section>

  <PledgeWall />
</BaseLayout>

<style>
  .hero {
    min-height: calc(100svh - 5.25rem);
    display: grid;
    grid-template-columns: minmax(360px, 37%) minmax(0, 63%);
    border-bottom: 1px solid var(--blue-soft);
  }

  .hero-copy {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    padding: clamp(4.2rem, 7vh, 5.5rem) clamp(1.5rem, 3vw, 4rem) 2rem var(--page-pad);
    border-right: 1px solid var(--blue-soft);
  }

  h1::after {
    content: "";
    display: block;
    width: 6.5rem;
    height: 3px;
    margin-top: 1rem;
    background: var(--red);
  }

  h1 {
    margin: 0 0 2.2rem;
    color: var(--ink);
    font-family: "Big Shoulders Display Variable", "Arial Narrow", sans-serif;
    font-size: clamp(6.2rem, 7.6vw, 8.6rem);
    font-weight: 600;
    letter-spacing: -.035em;
    line-height: .76;
  }

  h1 span { display: block; }

  .tool-label {
    margin: .2rem 0 0;
    color: var(--blue);
    font-family: "IBM Plex Mono", monospace;
    font-size: .72rem;
    letter-spacing: .08em;
  }

  .hero-lede {
    max-width: 28rem;
    margin: 1rem 0 1.7rem;
    color: var(--ink-muted);
    font-size: clamp(1rem, 1.2vw, 1.25rem);
    line-height: 1.55;
  }

  .hero-actions { display: flex; flex-direction: column; align-items: flex-start; gap: 1.2rem; }
  .hero-actions .button { width: min(100%, 25vw); min-height: 4.8rem; justify-content: space-between; padding-inline: 1.6rem; }
  .text-link {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    color: var(--ink-muted);
    font-size: .82rem;
    font-weight: 750;
    text-decoration-color: var(--blue-soft);
    text-underline-offset: .3rem;
  }

  .hero-meta {
    margin: auto 0 0;
    padding-top: 2rem;
    border-top: 1px solid var(--blue-soft);
    color: var(--blue);
    font-family: "IBM Plex Mono", monospace;
    font-size: .62rem;
    letter-spacing: .04em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .transcript {
    position: relative;
    min-width: 0;
    overflow: hidden;
    padding: clamp(3.1rem, 6vh, 4.8rem) clamp(1.4rem, 4.5vw, 5rem) 2rem clamp(2rem, 6vw, 7rem);
    background-color: var(--paper-bright);
    background-image:
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size: 28px 28px;
  }
  .transcript::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: clamp(1.25rem, 3.5vw, 3.75rem);
    width: 2px;
    background: rgba(214, 74, 53, .55);
  }

  .ruler {
    position: absolute;
    inset: 0 0 auto 0;
    height: 1.8rem;
    display: flex;
    align-items: flex-end;
    justify-content: space-around;
    padding: 0 1rem .25rem;
    border-bottom: 1px solid var(--blue-soft);
    color: var(--blue);
    font-family: "IBM Plex Mono", monospace;
    font-size: .58rem;
  }
  .ruler i { height: .45rem; border-left: 1px solid var(--blue-soft); }
  .demo-tag {
    position: absolute;
    top: 2.35rem;
    right: 1.5rem;
    margin: 0;
    padding: .35rem .55rem;
    border: 1px solid var(--blue-soft);
    color: var(--blue);
    background: rgba(244, 247, 251, .88);
    font-family: "IBM Plex Mono", monospace;
    font-size: .62rem;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .message {
    position: relative;
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 1rem;
    padding: .65rem 0;
    border-bottom: 1px solid var(--blue-soft);
    animation: transcript-entry 420ms cubic-bezier(.22, .8, .3, 1) backwards;
  }
  .message:nth-of-type(3) { animation-delay: 80ms; }
  .message:nth-of-type(4) { animation-delay: 150ms; }
  .message:nth-of-type(5) { animation-delay: 220ms; }
  .message p { margin: 0; }
  .message small { color: var(--ink-muted); font-family: "IBM Plex Mono", monospace; font-size: .6rem; }
  .question { margin-top: .5rem; align-items: center; }
  .speaker-line { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; color: var(--blue); }
  .speaker-line strong { font-size: clamp(1rem, 1.25vw, 1.25rem); }
  .speaker-line time { flex: 0 0 auto; font-family: "IBM Plex Mono", monospace; font-size: .62rem; font-weight: 500; }
  .claude-label { color: var(--red); }
  .avatar {
    width: 2.5rem;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    color: white;
    background: var(--blue);
    font-family: "IBM Plex Mono", monospace;
    font-size: .62rem;
  }

  .answer { max-width: 62rem; }
  .claude-mark { padding-top: .15rem; color: var(--red); }
  .answer-body > p:not(.tool-line) { font-size: clamp(.98rem, 1.2vw, 1.16rem); line-height: 1.5; }
  .tool-line {
    margin-top: .38rem !important;
    color: var(--ink-muted);
    font-family: "IBM Plex Mono", monospace;
    font-size: .67rem;
  }
  .tool-line::before { content: ""; display: inline-block; width: .5rem; height: .5rem; margin-right: .4rem; background: var(--green); }

  .follow-up { align-items: center; }
  .status-message .answer-body > p { color: var(--ink-muted); font-size: .86rem !important; }
  .working-dots { float: right; color: var(--blue); font-size: 1rem; letter-spacing: .28em; }
  .second-answer { border-bottom: 0; }

  .lesson-list { margin: .75rem 0; padding: 0; list-style: none; border-top: 2px solid var(--blue); }
  .lesson-list li {
    display: grid;
    grid-template-columns: 1.8rem 3.4rem minmax(6.5rem, .85fr) 1.4fr;
    gap: .55rem;
    align-items: baseline;
    min-height: 2.15rem;
    padding: .35rem .5rem;
    border-bottom: 1px solid var(--blue-soft);
    background: rgba(251, 252, 254, .76);
    font-size: clamp(.82rem, 1vw, .98rem);
  }
  .lesson-list time,
  .lesson-number { color: var(--blue); font-family: "IBM Plex Mono", monospace; font-size: .71rem; }
  .presence { color: var(--ink-muted); }

  .insight {
    position: relative;
    margin: 1rem 0 .35rem;
    padding: .85rem 1rem .85rem 1.25rem;
    border: 1px solid rgba(214, 74, 53, .25);
    background: rgba(242, 200, 75, .18);
  }
  .insight-title { margin-bottom: .25rem !important; color: var(--blue-strong); font-weight: 850; }
  .insight p { font-size: clamp(.78rem, 1vw, .95rem) !important; line-height: 1.48 !important; }
  .insight .all-good { margin-top: .42rem; color: var(--ink-muted); }
  .circled { position: relative; display: inline-block; color: var(--red); font-weight: 850; }
  .circled::after {
    content: "";
    position: absolute;
    inset: -.28rem -.45rem;
    border: 2px solid var(--red);
    border-radius: 48% 53% 45% 50%;
    transform: rotate(-3deg);
  }
  .bracket { position: absolute; top: -.45rem; left: -.75rem; width: .55rem; height: calc(100% + .9rem); border: 2px solid var(--red); border-right: 0; }

  .margin-note {
    position: absolute;
    right: 1.4rem;
    bottom: 1rem;
    margin: 0;
    color: var(--red);
    font-family: "IBM Plex Mono", monospace;
    font-size: .62rem;
    line-height: 1.45;
    transform: rotate(-2deg);
  }

  @keyframes transcript-entry {
    from { opacity: .01; transform: translateY(.65rem); }
    to { opacity: 1; transform: none; }
  }

  @media (max-width: 1050px) {
    .hero { grid-template-columns: 36% 64%; }
    h1 { font-size: clamp(4rem, 8vw, 6.4rem); }
    .transcript { padding-left: 3.5rem; }
    .lesson-list li { grid-template-columns: 1.7rem 3.2rem 1fr; }
    .lesson-list li > span:last-child { grid-column: 3; color: var(--ink-muted); }
    .hero-meta { display: none; }
  }

  @media (max-width: 760px) {
    .hero { min-height: auto; display: block; }
    .hero-copy { min-height: 32rem; padding: 4rem var(--page-pad) 3rem; border-right: 0; border-bottom: 1px solid var(--blue-soft); }
    h1 { font-size: clamp(4.8rem, 22vw, 6.6rem); }
    .hero-actions .button { width: 100%; }
    .transcript { padding: 4.4rem 1.1rem 4.5rem 3.3rem; }
    .demo-tag { top: 2.2rem; right: .75rem; font-size: .52rem; }
    .message { grid-template-columns: 2rem minmax(0, 1fr); gap: .7rem; }
    .avatar { width: 2rem; font-size: .54rem; }
    .claude-mark :global(svg) { width: 1.65rem; }
    .lesson-list li { grid-template-columns: 1.5rem 2.9rem 1fr; gap: .35rem; }
    .margin-note { right: .7rem; }
  }

  .value {
    display: grid;
    grid-template-columns: 37% 63%;
    border-bottom: 1px solid var(--blue-soft);
  }
  .value-heading { padding: clamp(4rem, 8vw, 8rem) var(--page-pad); border-right: 1px solid var(--blue-soft); }
  .value h2 { margin: 0; font-family: "Big Shoulders Display Variable", "Arial Narrow", sans-serif; font-size: clamp(4.5rem, 7vw, 7.8rem); font-weight: 600; line-height: .78; letter-spacing: -.035em; text-transform: uppercase; }
  .value-copy { padding: clamp(4rem, 8vw, 8rem) var(--page-pad); }
  .big-copy { max-width: 60rem; margin: 0; color: var(--blue); font-size: clamp(1.45rem, 2.2vw, 2.35rem); font-weight: 650; letter-spacing: -.035em; line-height: 1.32; }
  .value-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; margin: clamp(3rem, 6vw, 5.5rem) 0 2.5rem; border-top: 2px solid var(--blue); }
  .value-grid article { padding: 1.4rem 1.4rem 1.4rem 0; }
  .value-grid article + article { padding-left: 1.4rem; border-left: 1px solid var(--blue-soft); }
  .value-grid span { color: var(--red); font-family: "IBM Plex Mono", monospace; font-size: .68rem; }
  .value-grid h3 { margin: .7rem 0 .45rem; font-size: .94rem; }
  .value-grid p { margin: 0; color: var(--ink-muted); font-size: .78rem; line-height: 1.62; }
  .line-link { display: inline-flex; align-items: center; gap: .35rem; color: var(--blue); font-size: .82rem; font-weight: 800; text-underline-offset: .35rem; }

  @media (max-width: 800px) {
    .value { display: block; }
    .value-heading { border-right: 0; border-bottom: 1px solid var(--blue-soft); }
    .value h2 { font-size: clamp(4.2rem, 18vw, 6rem); }
    .value-grid { grid-template-columns: 1fr; }
    .value-grid article + article { padding-left: 0; border-left: 0; border-top: 1px solid var(--blue-soft); }
  }
</style>
