---
import BaseLayout from "../layouts/BaseLayout.astro";
import ChildProfiles from "../components/ChildProfiles.astro";
import ClaudeConnector from "../components/dashboard/ClaudeConnector.astro";
import DashboardSummary from "../components/dashboard/DashboardSummary.astro";
---

<BaseLayout
  title="Üzenőfüzet"
  description="Kapcsold össze a gyerekeid KRÉTA- és Classroom-adatait Claude-dal."
>
  <div class="workspace">
    <DashboardSummary />
    <ChildProfiles />
    <ClaudeConnector />
  </div>
</BaseLayout>

<style>
  .workspace {
    width: min(100%, 62rem);
    min-width: 0;
    margin: clamp(1.25rem, 2vw, 2rem) auto clamp(2.5rem, 5vw, 4.5rem);
    border: 1px solid var(--blue-soft);
    background: var(--paper-bright);
  }

  @media (max-width: 64rem) {
    .workspace { width: calc(100% - 2 * var(--page-pad)); }
  }

  @media (max-width: 560px) {
    .workspace { width: 100%; margin-block: 0 2rem; border-inline: 0; }
  }
</style>
