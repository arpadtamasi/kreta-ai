{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "public",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
          { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' https://apis.google.com; style-src 'self'; font-src 'self' data:; img-src 'self' data: https://lh3.googleusercontent.com; connect-src 'self' https://*.googleapis.com https://accounts.google.com; frame-src https://uzenofuzet.firebaseapp.com https://accounts.google.com; base-uri 'none'; form-action 'self'; frame-ancestors 'none'" }
        ]
      },
      {
        "source": "/_astro/**",
        "headers": [{ "key": "Cache-Control", "value": "public,max-age=31536000,immutable" }]
      },
      {
        "source": "**/*.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/api/**",
        "headers": [{ "key": "Cache-Control", "value": "no-store" }]
      }
    ],
    "rewrites": [
      {
        "source": "/health",
        "run": { "serviceId": "uzenofuzet", "region": "europe-west1" }
      },
      {
        "source": "/api/**",
        "run": { "serviceId": "uzenofuzet", "region": "europe-west1" }
      },
      {
        "source": "/mcp",
        "run": { "serviceId": "uzenofuzet", "region": "europe-west1" }
      },
      {
        "source": "/.well-known/**",
        "run": { "serviceId": "uzenofuzet", "region": "europe-west1" }
      },
      {
        "source": "/register",
        "run": { "serviceId": "uzenofuzet", "region": "europe-west1" }
      },
      {
        "source": "/authorize",
        "run": { "serviceId": "uzenofuzet", "region": "europe-west1" }
      },
      {
        "source": "/authorize.css",
        "run": { "serviceId": "uzenofuzet", "region": "europe-west1" }
      },
      {
        "source": "/token",
        "run": { "serviceId": "uzenofuzet", "region": "europe-west1" }
      }
    ]
  }
}
